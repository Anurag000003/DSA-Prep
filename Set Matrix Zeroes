class Solution {
public:
    void setZeroes(vector<vector<int>>& matrix) {
        int m = matrix.size();
        int n = matrix[0].size();
        unordered_map<int,int> row;
        unordered_map<int,int> col;
        for(int i=0; i<m; i++){
            for(int j=0; j<n; j++){
                if(matrix[i][j]==0){
                    row[i]=0;
                    col[j]=0;
                }
            }
        }
        for(auto ele : row){
            int rw = ele.first;
            for(int i=0; i<n; i++){
                matrix[rw][i]=0;
            }
        }
        for(auto ele : col){
            int cl = ele.first;
            for(int i=0; i<m; i++){
                matrix[i][cl]=0;
            }
        }
    }
};
