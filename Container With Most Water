class Solution {
public:
    int maxArea(vector<int>& height) {
        int n = height.size();
        int i=0,j=n-1;
        int mx = INT_MIN;
        while(i<j){
            if(height[i]<=height[j]){
                mx = max(mx,height[i]*(j-i));
                i++;
            }
            else{
                mx = max(mx,height[j]*(j-i));
                j--;
            }
            
        }
        return mx;
    }
};
