//method 1
class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {
        int n = nums.size();
        vector<int> prefix(n);
        prefix[0]=nums[0];
        for(int i=1; i<n; i++){
            prefix[i]=(prefix[i-1]+nums[i]);
        }
        unordered_map<int,int> mp;
        int count=0;
        mp[0]=1;
        for(int i=0; i<n; i++){
            if(mp.find(prefix[i]-k)!=mp.end()) count+=(mp[prefix[i]-k]);
            mp[prefix[i]]++;
        }
        return count;

    }
};

//method2
class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {
        int n = nums.size();
        int prefixsum=0;
        int count=0;
        unordered_map<int,int> mp;
        mp[0]=1;
        for(int i=0; i<n; i++){
            prefixsum+=nums[i];
            if(mp.find(prefixsum-k)!=mp.end()) count+=(mp[prefixsum-k]);
            mp[prefixsum]++;
        }
        return count;

    }
};
