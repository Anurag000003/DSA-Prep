//method 1
class Solution {
public:
    int trap(vector<int>& height) {
        int n = height.size();
        vector<int> rightgreater(n);
        rightgreater[n-1]=height[n-1];
        for(int i=n-2; i>=0; i--){
            rightgreater[i]=max(rightgreater[i+1],height[i]);
        }
        vector<int> leftgreater(n);
        leftgreater[0]=height[0];
        for(int i=1; i<n; i++){
            leftgreater[i]=max(leftgreater[i-1],height[i]);
        }
        int sum=0;
        for(int i=0; i<n; i++){
            sum+=(min(leftgreater[i],rightgreater[i])-height[i]);
        }
        return sum;


    }
};

//method 2
class Solution {
public:
    int trap(vector<int>& height) {
        int n = height.size();
        int ans=0;
        int lmx=0,rmx=0;
        int l=0,r=n-1;
        while(l<r){
            lmx = max(lmx,height[l]);
            rmx = max(rmx,height[r]);
            if(lmx<rmx){
                ans+=(lmx-height[l]);
                l++;
            }
            else{
                ans+=(rmx-height[r]);
                r--;
            }
        }
        return ans;
    }
};
