class Solution {
public:
    bool isPalindrome(string s) {
        int n = s.size();
        string t = "";
        for(int i=0; i<n; i++){
            char ch = s[i];
            if(ch>='A' && ch<='Z'){
                ch = ch + 32;
                t+=ch;
            }
            else if(ch>='a' && ch<='z') t+=ch;
            else if(ch>='0' && ch<='9') t+=ch;
        }
        int m = t.size();
        int i=0,j=m-1;
        while(i<=j){
            if(t[i]!=t[j]) return false;
            else{
                i++;
                j--;
            }
        }
        return true;
    }
};
